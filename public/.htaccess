# Keine Verzeichnis-Listings
Options -Indexes
DirectoryIndex home.php

RewriteEngine On

# Saubere URLs: /routen -> routen.php (nur wenn die .php-Datei existiert)
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}\.php -f
RewriteRule ^(.+?)/?$ $1.php [L]

# Eigene 404-Seite fuer nicht existierende Pfade.
# Relativer Pfad -> funktioniert unabhängig vom Installationsordner.
# (errors/404.php setzt http_response_code(404) selbst)
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ errors/404.php [L]

# Eigene 403-Seite beim direkten Zugriff auf ein Verzeichnis (Root ausgenommen).
# (errors/403.php setzt http_response_code(403) selbst)
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^.+ errors/403.php [L]
